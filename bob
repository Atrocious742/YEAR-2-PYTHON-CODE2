import pyautogui
import time
import math

pyautogui.FAILSAFE = True

IDLE_TIME = 5

# Get screen dimensions
SCREEN_W, SCREEN_H = pyautogui.size()

# Size of the infinity symbol as a fraction of the screen
RADIUS_X = SCREEN_W * 0.35
RADIUS_Y = SCREEN_H * 0.20

# Movement settings
FPS = 100
STEP = 0.04

last_manual_pos = pyautogui.position()
last_manual_time = time.monotonic()

center_x, center_y = last_manual_pos

angle = 0.0
moving = False

while True:
    pos = pyautogui.position()

    # Detect manual movement only when the script isn't moving the mouse
    if not moving:
        if pos != last_manual_pos:
            last_manual_pos = pos
            last_manual_time = time.monotonic()

            # Use the current position as the center
            center_x, center_y = pos
            angle = 0.0

    # Start infinity movement after being idle
    if not moving and time.monotonic() - last_manual_time >= IDLE_TIME:
        moving = True

    if moving:

        # Infinity / figure-8 curve
        x = center_x + RADIUS_X * math.sin(angle)
        y = center_y + RADIUS_Y * math.sin(2 * angle)

        # Keep cursor inside the screen
        x = max(0, min(SCREEN_W - 1, x))
        y = max(0, min(SCREEN_H - 1, y))

        pyautogui.moveTo(
            round(x),
            round(y),
            duration=0,
            _pause=False
        )

        angle += STEP

        # Check if the user moved the mouse
        new_pos = pyautogui.position()

        if (
            abs(new_pos.x - round(x)) > 3 or
            abs(new_pos.y - round(y)) > 3
        ):
            moving = False

            center_x, center_y = new_pos
            last_manual_pos = new_pos
            last_manual_time = time.monotonic()

        time.sleep(1 / FPS)

    else:
        time.sleep(0.02)
