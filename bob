import pyautogui
import time
import math

# =========================
# SETTINGS
# =========================

pyautogui.FAILSAFE = True
pyautogui.PAUSE = 0

IDLE_TIME = 5.0

# How fast the infinity loop runs
FPS = 100
STEP = 0.04

# Size of infinity loop
SCREEN_W, SCREEN_H = pyautogui.size()

RADIUS_X = SCREEN_W * 0.35
RADIUS_Y = SCREEN_H * 0.20

CENTER_X = SCREEN_W / 2
CENTER_Y = SCREEN_H / 2


# =========================
# STATE
# =========================

moving = False
angle = 0.0

last_user_position = pyautogui.position()
last_user_movement = time.monotonic()


# =========================
# MAIN LOOP
# =========================

print("Mouse mover running.")
print()
print("Automatic movement starts after 5 seconds of inactivity.")
print()
print("To STOP the program:")
print("  - Press CTRL+C in this Command Prompt")
print("  - OR move the mouse to the TOP-LEFT corner")
print()
print("Starting in 3 seconds...")

time.sleep(3)

try:

    while True:

        # ---------------------------------
        # ALWAYS CHECK CURRENT MOUSE POSITION
        # ---------------------------------

        current = pyautogui.position()

        # Explicit emergency stop
        if current.x <= 2 and current.y <= 2:
            print("Emergency stop.")
            break


        # =================================
        # USER HAS CONTROL
        # =================================

        if not moving:

            # Has the user moved the mouse?
            if current != last_user_position:

                last_user_position = current
                last_user_movement = time.monotonic()

            # Start automatically after exactly
            # IDLE_TIME seconds without movement
            elif time.monotonic() - last_user_movement >= IDLE_TIME:

                moving = True

                # ALWAYS start the infinity loop
                # from the same point.
                angle = 0.0

                print("Automatic movement started.")


        # =================================
        # AUTOMATIC MOVEMENT
        # =================================

        else:

            # Calculate infinity / figure-8 position
            x = (
                CENTER_X
                + RADIUS_X * math.sin(angle)
            )

            y = (
                CENTER_Y
                + RADIUS_Y * math.sin(2 * angle)
            )

            # Keep cursor safely inside screen
            x = max(1, min(SCREEN_W - 2, x))
            y = max(1, min(SCREEN_H - 2, y))

            target_x = round(x)
            target_y = round(y)

            # Move immediately
            pyautogui.moveTo(
                target_x,
                target_y,
                duration=0,
                _pause=False
            )

            # Advance the animation
            angle += STEP

            # Keep angle from growing forever
            if angle >= math.tau:
                angle -= math.tau

            # ---------------------------------
            # IMPORTANT:
            # Give the user a chance to take over
            # ---------------------------------

            time.sleep(1 / FPS)

            actual = pyautogui.position()

            # If the mouse isn't where WE just put it,
            # something else moved it.
            #
            # Therefore assume the user has taken control.
            if (
                abs(actual.x - target_x) > 10
                or
                abs(actual.y - target_y) > 10
            ):

                moving = False

                # Reset the idle timer NOW.
                last_user_position = actual
                last_user_movement = time.monotonic()

                print("User movement detected.")
                print("Waiting 5 seconds...")


except pyautogui.FailSafeException:

    print()
    print("Emergency stop: mouse reached the top-left corner.")


except KeyboardInterrupt:

    print()
    print("Stopped with CTRL+C.")


finally:

    print("Mouse mover stopped.")