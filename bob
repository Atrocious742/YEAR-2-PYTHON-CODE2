import pyautogui
import pystray
import time
import math
import threading

from PIL import Image, ImageDraw


# =========================
# SETTINGS
# =========================

pyautogui.FAILSAFE = True
pyautogui.PAUSE = 0

# Adjustable settings
IDLE_TIME = 5.0       # seconds
SPEED = 1.0           # movement speed multiplier
LOOP_SIZE = 100       # percentage of default loop size

# Animation update rate
FPS = 100

# =========================
# SCREEN / LOOP SETTINGS
# =========================

SCREEN_W, SCREEN_H = pyautogui.size()

CENTER_X = SCREEN_W / 2
CENTER_Y = SCREEN_H / 2

BASE_RADIUS_X = SCREEN_W * 0.35
BASE_RADIUS_Y = SCREEN_H * 0.20


# =========================
# STATE
# =========================

moving = False
running = True
angle = 0.0

last_user_position = pyautogui.position()
last_user_movement = time.monotonic()

state_lock = threading.Lock()


# =========================
# CALCULATE LOOP SIZE
# =========================

def get_radii():
    """
    LOOP_SIZE = 100 means normal size.
    50 = half size.
    150 = 1.5x size.
    """

    multiplier = LOOP_SIZE / 100.0

    radius_x = BASE_RADIUS_X * multiplier
    radius_y = BASE_RADIUS_Y * multiplier

    return radius_x, radius_y


# =========================
# MOUSE MOVEMENT THREAD
# =========================

def mouse_loop():

    global moving
    global angle
    global last_user_position
    global last_user_movement

    while running:

        current = pyautogui.position()

        # Emergency stop
        if current.x <= 2 and current.y <= 2:
            print("Emergency stop.")
            stop_program()
            return

        # =================================
        # USER HAS CONTROL
        # =================================

        if not moving:

            if current != last_user_position:

                last_user_position = current
                last_user_movement = time.monotonic()

            elif time.monotonic() - last_user_movement >= IDLE_TIME:

                moving = True
                angle = 0.0

                print("Automatic movement started.")

        # =================================
        # AUTOMATIC MOVEMENT
        # =================================

        else:

            radius_x, radius_y = get_radii()

            x = (
                CENTER_X
                + radius_x * math.sin(angle)
            )

            y = (
                CENTER_Y
                + radius_y * math.sin(2 * angle)
            )

            # Keep cursor inside screen
            x = max(1, min(SCREEN_W - 2, x))
            y = max(1, min(SCREEN_H - 2, y))

            target_x = round(x)
            target_y = round(y)

            pyautogui.moveTo(
                target_x,
                target_y,
                duration=0,
                _pause=False
            )

            # Speed controls how quickly the loop progresses.
            angle += 0.04 * SPEED

            if angle >= math.tau:
                angle -= math.tau

            time.sleep(1 / FPS)

            actual = pyautogui.position()

            # User has taken control
            if (
                abs(actual.x - target_x) > 10
                or abs(actual.y - target_y) > 10
            ):

                moving = False

                last_user_position = actual
                last_user_movement = time.monotonic()

                print("User movement detected.")
                print(f"Waiting {IDLE_TIME:.1f} seconds...")


# =========================
# TRAY ICON
# =========================

def create_icon():

    image = Image.new(
        "RGB",
        (64, 64),
        "black"
    )

    draw = ImageDraw.Draw(image)

    # Draw a simple infinity symbol
    points = []

    for i in range(100):

        a = i / 100 * math.tau

        x = 32 + 24 * math.sin(a)
        y = 32 + 16 * math.sin(2 * a)

        points.append((x, y))

    draw.line(
        points,
        fill="white",
        width=4
    )

    return image


