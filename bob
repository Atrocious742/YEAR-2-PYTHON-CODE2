import pyautogui
import time
import math

pyautogui.FAILSAFE = True

IDLE_TIME = 5

# Size of the infinity symbol
RADIUS_X = 30
RADIUS_Y = 15

# Movement settings
FPS = 100
STEP = 0.04

last_manual_pos = pyautogui.position()
last_manual_time = time.monotonic()

center_x, center_y = last_manual_pos

angle = 0.0
moving = False

while True:
    pos = pyautogui.position()

    # Only treat movement as manual when we're NOT controlling the mouse
    if not moving:
        if pos != last_manual_pos:
            last_manual_pos = pos
            last_manual_time = time.monotonic()

            # New anchor point
            center_x, center_y = pos
            angle = 0.0

    # Wait until the mouse has been idle
    if not moving and time.monotonic() - last_manual_time >= IDLE_TIME:
        moving = True

    if moving:
        # Figure-8 / infinity curve
        x = center_x + RADIUS_X * math.sin(angle)
        y = center_y + RADIUS_Y * math.sin(angle * 2)

        pyautogui.moveTo(
            round(x),
            round(y),
            duration=0,
            _pause=False
        )

        angle += STEP

        # Check whether the user has taken control.
        new_pos = pyautogui.position()

        expected_x = round(x)
        expected_y = round(y)

        if (
            abs(new_pos.x - expected_x) > 3 or
            abs(new_pos.y - expected_y) > 3
        ):
            moving = False
            center_x, center_y = new_pos
            last_manual_pos = new_pos
            last_manual_time = time.monotonic()

        time.sleep(1 / FPS)

    else:
        time.sleep(0.02)


