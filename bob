# =========================

def set_idle_time(value):

    global IDLE_TIME

    IDLE_TIME = float(value)

    print(f"Idle time: {IDLE_TIME} seconds")


def set_speed(value):

    global SPEED

    SPEED = float(value)

    print(f"Speed: {SPEED}x")


def set_loop_size(value):

    global LOOP_SIZE

    LOOP_SIZE = int(value)

    print(f"Loop size: {LOOP_SIZE}%")


def toggle_movement(icon, item):

    global moving
    global last_user_movement
    global last_user_position

    moving = not moving

    if moving:
        print("Movement enabled.")
    else:
        print("Movement paused.")

        # Reset idle timer
        last_user_position = pyautogui.position()
        last_user_movement = time.monotonic()


def stop_program():

    global running

    running = False


def exit_program(icon, item):

    global running

    running = False

    icon.stop()


